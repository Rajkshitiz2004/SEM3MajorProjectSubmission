# RajBhasha AI Frontend Environment Configuration

# Backend API base URL (FastAPI)
# Example for local development: http://localhost:8000
VITE_API_BASE_URL=http://localhost:5000

# Explicit mock mode toggle:
# Set to 'true' to use local mock translations (offline/demo mode)
# Set to 'false' or leave empty to use the live backend API
VITE_USE_MOCK_TRANSLATION=false

# Default website ID corresponding to the backend database registry
VITE_DEFAULT_WEBSITE_ID=1

# Request timeout in milliseconds (default: 8000ms)
VITE_TRANSLATION_TIMEOUT_MS=8000

