# RajBhasha AI - Frontend Environment Configuration

# 1. Translation API Base URL (Node.js/Express backend server)
VITE_API_BASE_URL=http://localhost:5001

# 2. Mock Translation Mode
# Set to 'false' to communicate with the local Node.js / Express backend
# Set to 'true' for offline standalone mock translation
VITE_USE_MOCK_TRANSLATION=false

# 3. Translation Request Timeout (milliseconds)
VITE_TRANSLATION_TIMEOUT_MS=15000

# 4. Default Website Identifier
VITE_DEFAULT_WEBSITE_ID=1

