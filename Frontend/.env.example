# RajBhasha AI - Frontend Environment Configuration

# 1. Translation API Base URL (FastAPI backend server)
# When running locally, the FastAPI backend typically runs on port 8000
VITE_API_BASE_URL=http://localhost:8000

# 2. Mock Translation Mode
# Set to 'true' for standalone offline demonstrations or testing without live FastAPI
# Set to 'false' for live AI translation powered by the Python FastAPI backend
VITE_USE_MOCK_TRANSLATION=true

# 3. Translation Request Timeout (milliseconds)
VITE_TRANSLATION_TIMEOUT_MS=8000

# 4. Default Website Identifier (passed to backend API for multi-tenant website support)
VITE_DEFAULT_WEBSITE_ID=1

