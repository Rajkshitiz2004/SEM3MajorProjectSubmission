# =============================================================================
# RajBhasha AI — Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/rajbhasha_db

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_here

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# AI Translation Service
# Provider-agnostic: any OpenAI-compatible chat-completions API is supported.
# Example providers: OpenAI, Azure OpenAI, Groq, Together AI, Ollama (local).
# -----------------------------------------------------------------------------

# API key (Bearer token) for the AI provider
AI_API_KEY=your_ai_api_key_here

# Base URL of the OpenAI-compatible endpoint (without trailing slash)
# OpenAI:   https://api.openai.com/v1
# Azure:    https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
# Groq:     https://api.groq.com/openai/v1
# Local:    http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# Model identifier (must match the provider's model name exactly)
# OpenAI examples: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
# Groq examples:   llama3-70b-8192, mixtral-8x7b-32768
AI_MODEL=gpt-4o-mini

# Request timeout in milliseconds (default: 20000 = 20 seconds)
AI_TIMEOUT_MS=20000

